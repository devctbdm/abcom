# PostgreSQL connection string used by Drizzle ORM (src/db/index.ts)
# Server-side only — never expose this to the browser bundle.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign session cookies (JWT HS256)
AUTH_SECRET=change-me-to-a-long-random-string

# Resend (transactional email) — password reset emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=FuelRide <onboarding@resend.dev>
